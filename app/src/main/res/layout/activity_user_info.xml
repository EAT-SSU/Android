<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.mypage.userinfo.UserInfoActivity">

    <TextView
        android:id="@+id/tv_nickname_set"
        style="@style/Body2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="닉네임 설정"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ll_change_nickname"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname_set">

        <EditText
            android:id="@+id/et_ch_nickname"
            style="@style/Body2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/shape_text_field_small"
            android:hint="@string/set_nickname"
            android:inputType="text"
            android:maxLength="8"
            android:maxLines="1"
            android:textColorHint="@color/gray400"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_ch_nickname" />

        <Button
            android:id="@+id/btn_check_nickname"
            style="@style/Button2"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/shape_button_duplicate"
            android:stateListAnimator="@null"
            android:text="중복확인"
            app:layout_constraintStart_toEndOf="@+id/et_ch_nickname" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_nickname_2_8"
        style="@style/Caption2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/set_nickname_2_8"
        android:textColor="@color/gray600"
        app:layout_constraintStart_toStartOf="@+id/ll_change_nickname"
        app:layout_constraintTop_toBottomOf="@+id/ll_change_nickname" />

    <!-- 소속 설정 -->
    <TextView
        android:id="@+id/tv_college_label"
        style="@style/Body2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="소속 설정"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/tv_nickname_2_8"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp" />

    <!-- 단과대 선택 -->
    <FrameLayout
        android:id="@+id/fl_college"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/shape_text_field_small"
        app:layout_constraintTop_toBottomOf="@id/tv_college_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_college"
            style="@style/Body2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingEnd="40dp"
            android:text="단과대"
            android:textColor="@color/gray400" />

        <ImageView
            android:id="@+id/iv_college_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_arrow_down"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- 학과 선택 -->
    <FrameLayout
        android:id="@+id/fl_department"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/shape_text_field_small"
        app:layout_constraintTop_toBottomOf="@id/fl_college"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_department"
            style="@style/Body2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingEnd="40dp"
            android:text="학과"
            android:textColor="@color/gray400" />

        <ImageView
            android:id="@+id/iv_department_marrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_arrow_down"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- 계정 레이아웃 -->
    <LinearLayout
        android:id="@+id/ll_account_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_department"
        android:paddingTop="40dp"
        android:layout_marginHorizontal="24dp">

        <TextView
            android:id="@+id/tv_account"
            style="@style/Body2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect_account"
            android:textColor="@color/black" />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_account_type"
            style="@style/Body3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/kakao"
            android:textColor="@color/black" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_kakao_login" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_complete"
        style="@style/Button1"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="24dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/shape_button_duplicate"
        android:stateListAnimator="@null"
        android:text="@string/save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>