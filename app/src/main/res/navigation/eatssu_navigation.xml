<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/eatssu_navigation"
    app:startDestination="@id/cafeteria_menu"
    >

    <!-- 첫 번째 화면 (Cafeteria Menu) -->
    <fragment
        android:id="@+id/cafeteria_menu"
        android:name="com.eatssu.android.presentation.cafeteria.CafeteriaFragment"
        android:label="Cafeteria Menu"/>

    <!-- 두 번째 화면 (Map) -->
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.eatssu.android.presentation.map.MapFragment"
        android:label="Map"/>

    <fragment
        android:id="@+id/favoriteFragment"
        android:name="com.eatssu.android.presentation.favorite.FavoriteFragment"
        android:label="Favorite" />

    <fragment
        android:id="@+id/favoriteDetailFragment"
        android:name="com.eatssu.android.presentation.favorite.FavoriteDetailFragment"
        android:label="Favorite Detail">
        <argument
            android:name="partnershipId"
            app:argType="integer" />
    </fragment>

    <!-- 세 번째 화면 (MyPage) -->
    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.eatssu.android.presentation.mypage.MyPageFragment"
        android:label="MyPage"/>

</navigation>
